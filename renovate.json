{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinDigests", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "enabledManagers": ["gomod", "dockerfile", "github-actions", "pip_requirements"],
  "packageRules": [
    {"matchManagers": ["gomod"], "matchPackageNames": ["github.com/caddyserver/caddy/v2", "github.com/caddy-dns/cloudflare"], "groupName": "Caddy and Cloudflare"}
  ]
}

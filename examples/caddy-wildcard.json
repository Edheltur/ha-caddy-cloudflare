{
  "admin": {
    "disabled": true,
    "config": {
      "persist": false
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/data/caddy"
  },
  "apps": {
    "http": {
      "grace_period": "15s",
      "servers": {
        "proxy": {
          "listen": [
            "0.0.0.0:8443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "strict_sni_host": true,
          "automatic_https": {
            "disable": true
          },
          "tls_connection_policies": [
            {
              "match": {
                "sni": [
                  "ha.example.com"
                ]
              },
              "protocol_min": "tls1.2",
              "client_authentication": {
                "mode": "require_and_verify",
                "ca": {
                  "provider": "file",
                  "pem_files": [
                    "/config/client-ca.pem"
                  ]
                }
              }
            },
            {
              "match": {
                "sni": [
                  "ma.example.com"
                ]
              },
              "protocol_min": "tls1.2"
            }
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "ha.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "homeassistant:8123"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "ma.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "music-assistant:8095"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 421
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": [
          "*.example.com"
        ]
      },
      "automation": {
        "policies": [
          {
            "subjects": [
              "*.example.com"
            ],
            "issuers": [
              {
                "module": "acme",
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "challenges": {
                  "http": {
                    "disabled": true
                  },
                  "tls-alpn": {
                    "disabled": true
                  },
                  "dns": {
                    "provider": {
                      "name": "cloudflare",
                      "api_token": "{env.CF_API_TOKEN}"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}

ha.example.com {
	tls {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /data/caddy/client-ca.pem
			}
		}
	}
	reverse_proxy homeassistant:8123
}


{
	admin off
	persist_config off
	https_port 8443
	default_bind 0.0.0.0
	auto_https disable_redirects
	grace_period 15s
	storage file_system {
		root /data/caddy
	}
	cert_issuer acme {
		dir https://acme-v02.api.letsencrypt.org/directory
		dns cloudflare {env.CF_API_TOKEN}
		disable_http_challenge
		disable_tlsalpn_challenge
	}
	servers {
		protocols h1 h2
		strict_sni_host on
	}
}

